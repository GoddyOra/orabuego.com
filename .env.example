# Copy to .env.local for local dev (gitignored). Set the same two vars
# in the Vercel dashboard (Project -> Settings -> Environment Variables)
# for production.

# Resend API key — resend.com, free tier (3,000 emails/mo).
RESEND_API_KEY=

# Where contact-form submissions get sent. Until orabuego.com is verified
# as a sending domain in Resend, the API only delivers to the email
# address on the Resend account itself — see docs/BUILD_PLAN.md Phase 6.
CONTACT_TO_EMAIL=
